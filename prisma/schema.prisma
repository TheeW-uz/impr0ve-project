// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  avatarUrl    String?
  bio          String?
  xp           Int      @default(0)
  level        Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings              Settings?
  dailyGoals            DailyGoal[]
  monthlyGoals          MonthlyGoal[]
  yearlyGoals           YearlyGoal[]
  lifetimeGoals         LifetimeGoal[]
  sideQuests            SideQuest[]
  codingActivities      CodingActivity[]
  activityLogs          ActivityLog[]
  contributionDays      ContributionDay[]
  refreshTokens         RefreshToken[]
  stuffToDoItems        StuffToDoItem[]
  bannedActivities      BannedActivity[]
  punishmentRules       PunishmentRule[]
  punishmentAssignments PunishmentAssignment[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────────────────────────
model Settings {
  id              String   @id @default(cuid())
  userId          String   @unique
  theme           String   @default("dark")
  dailyReminders  Boolean  @default(true)
  goalDeadlines   Boolean  @default(true)
  marketingEmails Boolean  @default(false)
  timezone        String   @default("UTC")
  weekStartsOn    Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// ─────────────────────────────────────────────────────────────────
// REFRESH TOKEN
// ─────────────────────────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────
// DAILY GOAL
// ─────────────────────────────────────────────────────────────────
model DailyGoal {
  id                  String    @id @default(cuid())
  userId              String
  dateKey             String
  title               String
  notes               String    @default("")
  priority            Priority  @default(MEDIUM)
  progress            Int       @default(0)
  completed           Boolean   @default(false)
  failed              Boolean   @default(false)
  completedAt         DateTime?
  failedAt            DateTime?
  timeEstimateMinutes Int       @default(30)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks DailySubtask[]

  @@index([userId, dateKey])
  @@map("daily_goals")
}

model DailySubtask {
  id          String    @id @default(cuid())
  goalId      String
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  goal DailyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("daily_subtasks")
}

// ─────────────────────────────────────────────────────────────────
// MONTHLY GOAL
// ─────────────────────────────────────────────────────────────────
model MonthlyGoal {
  id          String    @id @default(cuid())
  userId      String
  monthKey    String
  title       String
  notes       String    @default("")
  priority    Priority  @default(MEDIUM)
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  failed      Boolean   @default(false)
  completedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks MonthlySubtask[]

  @@index([userId, monthKey])
  @@map("monthly_goals")
}

model MonthlySubtask {
  id          String    @id @default(cuid())
  goalId      String
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  goal MonthlyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("monthly_subtasks")
}

// ─────────────────────────────────────────────────────────────────
// YEARLY GOAL
// ─────────────────────────────────────────────────────────────────
model YearlyGoal {
  id          String    @id @default(cuid())
  userId      String
  yearKey     String
  title       String
  notes       String    @default("")
  priority    Priority  @default(MEDIUM)
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  failed      Boolean   @default(false)
  completedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks YearlySubtask[]

  @@index([userId, yearKey])
  @@map("yearly_goals")
}

model YearlySubtask {
  id          String    @id @default(cuid())
  goalId      String
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  goal YearlyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("yearly_subtasks")
}

// ─────────────────────────────────────────────────────────────────
// LIFETIME GOAL
// ─────────────────────────────────────────────────────────────────
model LifetimeGoal {
  id             String    @id @default(cuid())
  userId         String
  title          String
  notes          String    @default("")
  progress       Int       @default(0)
  completed      Boolean   @default(false)
  completedAt    DateTime?
  category       String    @default("Personal")
  estimatedYears Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones LifetimeMilestone[]
  journal    LifetimeJournal[]

  @@index([userId])
  @@map("lifetime_goals")
}

model LifetimeMilestone {
  id          String    @id @default(cuid())
  goalId      String
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  targetDate  DateTime?
  createdAt   DateTime  @default(now())

  goal LifetimeGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("lifetime_milestones")
}

model LifetimeJournal {
  id               String   @id @default(cuid())
  goalId           String
  content          String
  progressSnapshot Int      @default(0)
  createdAt        DateTime @default(now())

  goal LifetimeGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("lifetime_journal")
}

// ─────────────────────────────────────────────────────────────────
// SIDE QUEST
// ─────────────────────────────────────────────────────────────────
model SideQuest {
  id            String    @id @default(cuid())
  userId        String
  title         String
  notes         String    @default("")
  totalDays     Int
  completedDays Int       @default(0)
  completed     Boolean   @default(false)
  startDate     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("side_quests")
}

// ─────────────────────────────────────────────────────────────────
// BANNED ACTIVITIES
// ─────────────────────────────────────────────────────────────────
model BannedActivity {
  id           String    @id @default(cuid())
  userId       String
  title        String
  reason       String?
  category     String?
  severity     Severity  @default(LOW)
  notes        String    @default("")
  timesBroken  Int       @default(0)
  lastBrokenAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("banned_activities")
}

// ─────────────────────────────────────────────────────────────────
// PUNISHMENT RULES
// ─────────────────────────────────────────────────────────────────
model PunishmentRule {
  id                   String    @id @default(cuid())
  userId               String
  title                String
  description          String    @default("")
  appliesTo            AppliesTo
  failedCountThreshold Int
  punishmentType       String
  punishmentAction     String
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments PunishmentAssignment[]

  @@index([userId])
  @@map("punishment_rules")
}

// ─────────────────────────────────────────────────────────────────
// PUNISHMENT ASSIGNMENTS
// ─────────────────────────────────────────────────────────────────
model PunishmentAssignment {
  id               String           @id @default(cuid())
  userId           String
  ruleId           String
  sourceType       AppliesTo
  sourceId         String?
  sourcePeriod     String?
  reason           String           @default("")
  punishmentAction String
  status           AssignmentStatus @default(PENDING)
  assignedAt       DateTime         @default(now())
  completedAt      DateTime?

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule PunishmentRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([userId, ruleId, sourcePeriod])
  @@index([userId])
  @@map("punishment_assignments")
}

// ─────────────────────────────────────────────────────────────────
// CODING ACTIVITY
// ─────────────────────────────────────────────────────────────────
model CodingActivity {
  id           String   @id @default(cuid())
  userId       String
  dateKey      String
  title        String
  description  String   @default("")
  minutesSpent Int
  language     String?
  xpEarned     Int      @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateKey])
  @@map("coding_activities")
}

// ─────────────────────────────────────────────────────────────────
// CONTRIBUTION GRAPH
// ─────────────────────────────────────────────────────────────────
model ContributionDay {
  id           String   @id @default(cuid())
  userId       String
  dateKey      String
  count        Int      @default(0)
  xpEarned     Int      @default(0)
  minutesSpent Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@map("contribution_days")
}

// ─────────────────────────────────────────────────────────────────
// ACTIVITY LOG
// ─────────────────────────────────────────────────────────────────
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  type      String
  entityId  String?
  metadata  Json?
  xpDelta   Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity_logs")
}

// ─────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum AppliesTo {
  TODO
  MONTHLY
  YEARLY
}

enum AssignmentStatus {
  PENDING
  COMPLETED
  SKIPPED
}

// ─────────────────────────────────────────────────────────────────
// STUFF TO DO (Lifestyle/Activity Planner)
// ─────────────────────────────────────────────────────────────────
model StuffToDoItem {
  id          String    @id @default(cuid())
  userId      String
  title       String
  category    String    // Movies, Social, Physical, Productivity, Learning, Fun, Travel, Other
  note        String    @default("")
  plannedDate DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("stuff_to_do_items")
}
