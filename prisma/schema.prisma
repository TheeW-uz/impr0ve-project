generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                  @id @default(cuid())
  email                 String                  @unique
  username              String                  @unique
  passwordHash          String
  avatarUrl             String?
  bio                   String?
  xp                    Int                     @default(0)
  level                 Int                     @default(1)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  activityLogs          ActivityLog[]
  bannedActivities      BannedActivity[]
  codingContributions   CodingContributionDay[]
  codingSessions        CodingSession[]
  codingStats           CodingStats?
  dailyGoals            DailyGoal[]
  lifetimeGoals         LifetimeGoal[]
  monthlyGoals          MonthlyGoal[]
  punishmentAssignments PunishmentAssignment[]
  punishmentRules       PunishmentRule[]
  refreshTokens         RefreshToken[]
  settings              Settings?
  sideQuests            SideQuest[]
  stuffToDoItems        StuffToDoItem[]
  trustedDevices        TrustedDevice[]
  verificationCodes     VerificationCode[]
  yearlyGoals           YearlyGoal[]

  @@map("users")
}

model Settings {
  id              String   @id @default(cuid())
  userId          String   @unique
  theme           String   @default("dark")
  dailyReminders  Boolean  @default(true)
  goalDeadlines   Boolean  @default(true)
  marketingEmails Boolean  @default(false)
  timezone        String   @default("UTC")
  weekStartsOn    Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model DailyGoal {
  id                  String         @id @default(cuid())
  userId              String
  dateKey             String
  title               String
  notes               String         @default("")
  priority            Priority       @default(MEDIUM)
  progress            Int            @default(0)
  completed           Boolean        @default(false)
  failed              Boolean        @default(false)
  completedAt         DateTime?
  failedAt            DateTime?
  timeEstimateMinutes Int            @default(30)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks            DailySubtask[]

  @@index([userId, dateKey])
  @@map("daily_goals")
}

model DailySubtask {
  id          String    @id @default(cuid())
  goalId      String
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  goal        DailyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("daily_subtasks")
}

model MonthlyGoal {
  id          String           @id @default(cuid())
  userId      String
  monthKey    String
  title       String
  notes       String           @default("")
  priority    Priority         @default(MEDIUM)
  progress    Int              @default(0)
  completed   Boolean          @default(false)
  failed      Boolean          @default(false)
  completedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks    MonthlySubtask[]

  @@index([userId, monthKey])
  @@map("monthly_goals")
}

model MonthlySubtask {
  id          String      @id @default(cuid())
  goalId      String
  title       String
  completed   Boolean     @default(false)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  goal        MonthlyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("monthly_subtasks")
}

model YearlyGoal {
  id          String          @id @default(cuid())
  userId      String
  yearKey     String
  title       String
  notes       String          @default("")
  priority    Priority        @default(MEDIUM)
  progress    Int             @default(0)
  completed   Boolean         @default(false)
  failed      Boolean         @default(false)
  completedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks    YearlySubtask[]

  @@index([userId, yearKey])
  @@map("yearly_goals")
}

model YearlySubtask {
  id          String     @id @default(cuid())
  goalId      String
  title       String
  completed   Boolean    @default(false)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  goal        YearlyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("yearly_subtasks")
}

model LifetimeGoal {
  id             String              @id @default(cuid())
  userId         String
  title          String
  notes          String              @default("")
  progress       Int                 @default(0)
  completed      Boolean             @default(false)
  completedAt    DateTime?
  category       String              @default("Personal")
  estimatedYears Float?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal        LifetimeJournal[]
  milestones     LifetimeMilestone[]

  @@index([userId])
  @@map("lifetime_goals")
}

model LifetimeMilestone {
  id          String       @id @default(cuid())
  goalId      String
  title       String
  completed   Boolean      @default(false)
  completedAt DateTime?
  targetDate  DateTime?
  createdAt   DateTime     @default(now())
  goal        LifetimeGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("lifetime_milestones")
}

model LifetimeJournal {
  id               String       @id @default(cuid())
  goalId           String
  content          String
  progressSnapshot Int          @default(0)
  createdAt        DateTime     @default(now())
  goal             LifetimeGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("lifetime_journal")
}

model SideQuest {
  id            String    @id @default(cuid())
  userId        String
  title         String
  notes         String    @default("")
  totalDays     Int
  completedDays Int       @default(0)
  completed     Boolean   @default(false)
  startDate     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("side_quests")
}

model BannedActivity {
  id           String    @id @default(cuid())
  userId       String
  title        String
  reason       String?
  category     String?
  severity     Severity  @default(LOW)
  notes        String    @default("")
  timesBroken  Int       @default(0)
  lastBrokenAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("banned_activities")
}

model PunishmentRule {
  id                   String                 @id @default(cuid())
  userId               String
  title                String
  description          String                 @default("")
  appliesTo            AppliesTo
  failedCountThreshold Int
  punishmentType       String
  punishmentAction     String
  active               Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  assignments          PunishmentAssignment[]
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("punishment_rules")
}

model PunishmentAssignment {
  id               String           @id @default(cuid())
  userId           String
  ruleId           String
  sourceType       AppliesTo
  sourceId         String?
  sourcePeriod     String?
  reason           String           @default("")
  punishmentAction String
  status           AssignmentStatus @default(PENDING)
  assignedAt       DateTime         @default(now())
  completedAt      DateTime?
  rule             PunishmentRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ruleId, sourcePeriod])
  @@index([userId])
  @@map("punishment_assignments")
}

model CodingSession {
  id              String   @id @default(cuid())
  userId          String
  title           String
  projectName     String   @default("General")
  language        String   @default("Other")
  durationMinutes Int      @default(0)
  problemsSolved  Int      @default(0)
  difficulty      String   @default("Medium")
  notes           String   @default("")
  completed       Boolean  @default(true)
  sessionDate     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sessionDate])
  @@map("coding_sessions")
}

model CodingContributionDay {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  dateKey      String
  count        Int      @default(0)
  totalMinutes Int      @default(0)
  intensity    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@map("coding_contribution_days")
}

model CodingStats {
  id              String    @id @default(cuid())
  userId          String    @unique
  totalSessions   Int       @default(0)
  totalMinutes    Int       @default(0)
  totalProblems   Int       @default(0)
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastSessionDate DateTime?
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coding_stats")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  type      String
  entityId  String?
  metadata  Json?
  xpDelta   Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity_logs")
}

model StuffToDoItem {
  id          String    @id @default(cuid())
  userId      String
  title       String
  category    String
  note        String    @default("")
  plannedDate DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("stuff_to_do_items")
}

model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String
  deviceName String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("trusted_devices")
}

model VerificationCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_codes")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum AppliesTo {
  TODO
  MONTHLY
  YEARLY
}

enum AssignmentStatus {
  PENDING
  COMPLETED
  SKIPPED
}
